exports[`splitTags JSON protection > json guard keeps object opaque and notifies via hooks > array-wrapped is not {}-wrapped: normal split, NOT notified — [3a1db008] \"[1], [2]\" (false, false, {}, {onJsonIgnored: undefined}) 1`] = `
