exports[`genPrompt > genPrompt cases > BREAK 標籤 — 前段以空白分隔，BREAK 後段以空白分隔 1`] = `
{
  "input": [
    {
      "type": "text",
      "value": "cat",
      "localValue": ""
    },
    {
      "type": "BREAK",
      "value": "BREAK",
      "localValue": ""
    },
    {
      "type": "text",
      "value": "dog",
      "localValue": ""
    }
  ],
  "result": "cat BREAK dog, "
}
`;

exports[`genPrompt > genPrompt cases > autoOptimizeSplitSymbol + autoRemoveLoraAfterComma — 末段 Lora 的逗號換成空白（autoRemoveSpace 關閉時保留空白） (false, {autoOptimizeSplitSymbol: true, autoRemoveLoraAfterComma: true}) 1`] = `
{
  "input": [
    {
      "type": "lora",
      "value": "<lora:foo:1>",
      "isLora": true,
      "localValue": ""
    },
    {
      "type": "lora",
      "value": "<lora:bar:1>",
      "isLora": true,
      "localValue": ""
    }
  ],
  "args": [
    false,
    {
      "autoOptimizeSplitSymbol": true,
      "autoRemoveLoraAfterComma": true
    }
  ],
  "result": "<lora:foo:1> <lora:bar:1> "
}
`;

exports[`genPrompt > genPrompt cases > autoOptimizeSplitSymbol — '#' 本身不觸發換行前逗號移除（規則 3 目前停用） (false, {autoOptimizeSplitSymbol: true}) 1`] = `
{
  "input": [
    {
      "type": "text",
      "value": "#",
      "localValue": ""
    },
    {
      "type": "wrap",
      "value": "\\n",
      "localValue": "\\n"
    },
    {
      "type": "text",
      "value": "cat",
      "localValue": ""
    }
  ],
  "args": [
    false,
    {
      "autoOptimizeSplitSymbol": true
    }
  ],
  "result": "#, \\ncat, "
}
`;

