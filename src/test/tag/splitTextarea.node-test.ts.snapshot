  "input": {
    "value": "a, b",
    "prompt": "a, X, b",
    "tags": [
      {
        "type": "text",
        "value": "a"
      },
      {
        "type": "text",
        "value": "X",
        "disabled": true
      },
      {
        "type": "text",
        "value": "b"
      }
    ]
  },
  "changed": true,
  "values": [
    "a",
    "X",
    "b"
  ]
}
`;

